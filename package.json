  "private": true,
  "license": "AGPL-3.0-only",
  "description": "OperiX Invoice: open-source invoicing and accounting web app",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/OperiX Invoice/OperiX Web",
    "packages/accounting",
